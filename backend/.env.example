# Skopiuj do backend/.env i uzupełnij prawdziwymi wartościami.
# backend/.env jest w .gitignore i NIE trafi do repozytorium.

# ---------------------------------------------------------------
# Neon (https://console.neon.tech)
#   Project -> Connection Details -> Connection string
#   Wybierz "Pooled connection" (host zawiera "-pooler") — lepiej
#   znosi wiele krótkich połączeń, co pasuje do tej aplikacji.
#   Zostaw na końcu ?sslmode=require — Neon wymaga SSL.
# ---------------------------------------------------------------
DATABASE_URL=postgres://uzytkownik:haslo@ep-nazwa-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Sekret do podpisywania tokenów logowania
JWT_SECRET=zmien-to-na-dlugi-losowy-ciag

# Adres frontendu, któremu backend pozwala na zapytania
CORS_ORIGIN=http://localhost:5173
